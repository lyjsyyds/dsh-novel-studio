{
  "name": "dsh-novel-studio-lyjs",
  "version": "1.3.0",
  "description": "Novel Studio — a dedicated writing partition for DSH: characters, worldbuilding, outline, panels, chapters.",
  "license": "MIT",
  "author": "LYJS",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build:studio": "vite build --config standalone/vite.config.mjs",
    "prepack": "npm run build:studio && node scripts/stage-dsh.mjs",
    "start:studio": "npm run build:studio && electron standalone/desktop/main.cjs",
    "build:windows": "npm run build:studio && electron-builder --win portable --config standalone/desktop/builder.json --publish never",
    "sync:android": "npm run build:studio && cap sync android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyjsyyds/dsh-novel-studio.git"
  },
  "homepage": "https://github.com/lyjsyyds/dsh-novel-studio#readme",
  "bugs": {
    "url": "https://github.com/lyjsyyds/dsh-novel-studio/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "novel",
    "writing",
    "markdown"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "lib/studio",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "EXTENSIONS.md"
  ],
  "icon": "icon.svg",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@noble/hashes": "^2.4.0",
    "buffer": "^6.0.3",
    "diff": "^9.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "path-browserify": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.3.8"
  }
}
